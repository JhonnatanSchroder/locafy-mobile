{
  "expo": {
    "name": "Locafy",
    "slug": "locafy",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/branding/icon.png",
    "scheme": "locafymobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/icon.png"
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/branding/icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.locafy.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/branding/splash-logo.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Locafy acessa suas fotos para anexar imagens aos contratos.",
          "cameraPermission": "O Locafy usa a câmera para fotografar contratos e itens locados.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c1489314-2585-48d1-b1e6-4be65a74a650"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c1489314-2585-48d1-b1e6-4be65a74a650",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
